"AppBuild"
{
	"AppID"	"480"	// your app id
	"Desc"	"SHELF ROYALE Windows build"
	"ContentRoot"	".\build\windows\"	// the unzipped AISlopArena-steam-windows.zip (exe, pck, addons)
	"BuildOutput"	".\output\"
	"Depots"
	{
		"481"	// your Windows depot id
		{
			"FileMapping"
			{
				"LocalPath"	"*"
				"DepotPath"	"."
				"recursive"	"1"
			}
		}
	}
}
