{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-slop-arena",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  // Sentry (worker/index.js) keeps its context across async calls with AsyncLocalStorage.
  "compatibility_flags": ["nodejs_als"],
  // Crash reports of the server. Not a secret: it only lets you send errors to this project.
  "vars": { "SENTRY_DSN": "https://2da73477bec11b9288f393c3d34ffb98@o4511078519078912.ingest.de.sentry.io/4512143829827664" },
  // The Vite build is served as static assets; /ws, /mm, /api and /admin reach the Worker code.
  // worker/build/sim.js (the headless game) comes from `vite build --mode server` (npm run build).
  // /play (the game's URL, invite links /play?room=CODE) always reaches the Worker: it redirects to the
  // Godot client, even if an old play.html were still in the assets.
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/play", "/play.html", "/play/*"] },
  // The Godot client's web export (index.pck / index.wasm exceed the 25 MiB asset limit), served at
  // /godot/ by worker/godot-web.js; uploaded by `npm run deploy:godot-web` under godot/<version>/.
  "r2_buckets": [{ "binding": "GODOT_WEB", "bucket_name": "ai-slop-arena-godot-web" }],
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "MATCHMAKER", "class_name": "Matchmaker" },
      { "name": "MOD", "class_name": "Moderation" },
      { "name": "PLAYERS", "class_name": "Players" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Matchmaker", "Moderation"] },
    { "tag": "v3", "new_sqlite_classes": ["Players"] }
  ],
  "observability": { "enabled": true }
}
